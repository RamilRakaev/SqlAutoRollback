<Window x:Class="SqlAutoRollback.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="SqlAutoRollback"
        Height="800"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuteCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewQueryCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveQueryCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="#666"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ShowConnectCommand}"
                        ToolTip="Connect to SQL Server">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE968;" Foreground="#0078D4"/>
                        <TextBlock Text="Connect" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding OpenFileCommand}"
                        ToolTip="Open file">
                    <TextBlock Style="{StaticResource GlyphText}" Margin="0" Text="&#xE8E5;"/>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding NewQueryCommand}"
                        ToolTip="New query (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8A5;"/>
                        <TextBlock Text="New Query" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding SaveQueryCommand}"
                        ToolTip="Save (Ctrl+S)">
                    <TextBlock Style="{StaticResource GlyphText}" Margin="0" Text="&#xE74E;"/>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding SaveAllCommand}"
                        ToolTip="Save all (Ctrl+Shift+S)">
                    <Grid Width="18" Height="16">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14" Margin="3,2,0,0" Opacity="0.7"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ExecuteCommand}"
                        ToolTip="Execute (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE768;" Foreground="#2E7D32"/>
                        <TextBlock Text="Execute" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelHeaderBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <TextBlock Text="Object Explorer" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="No connections"
                               Foreground="#888"
                               Margin="12,16"
                               Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}"/>

                    <ListBox ItemsSource="{Binding Connections}"
                             SelectedItem="{Binding ActiveConnection}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="8,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ExplorerSelectionBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ExplorerSelectionBorderBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8F1;"
                                               Foreground="#0078D4"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding DisplayName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource WindowBackgroundBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="160"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="White">
                    <TextBlock Text="Open a file or click New Query to start editing."
                               Foreground="#888"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ActiveDocument, Converter={StaticResource NotNullToCollapsed}}"/>

                    <TabControl ItemsSource="{Binding Documents}"
                                SelectedItem="{Binding ActiveDocument}"
                                Visibility="{Binding ActiveDocument, Converter={StaticResource NullToVisibility}}"
                                BorderThickness="0"
                                Padding="0"
                                Background="White">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource TabCloseButtonStyle}"
                                            ToolTip="Close"
                                            Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <avalonedit:TextEditor Document="{Binding Document}"
                                                       SyntaxHighlighting="SQL"
                                                       ShowLineNumbers="True"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       WordWrap="False"
                                                       Background="White"
                                                       Foreground="#1E1E1E"
                                                       Padding="4,2"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource WindowBackgroundBrush}"/>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushSubtle}"
                        BorderThickness="0,1,0,0">
                    <TabControl SelectedIndex="{Binding SelectedBottomTab}"
                                BorderThickness="0"
                                Background="White"
                                Padding="0">
                        <TabItem Header="Results">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0"
                                         Text="{Binding ResultMessage, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0,0,0,1"
                                         BorderBrush="{StaticResource BorderBrushSubtle}"
                                         Padding="8,6"
                                         MinHeight="28"
                                         MaxHeight="96"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="{Binding HasExecutionError, Converter={StaticResource ErrorBrush}}"
                                         Background="#FAFAFA"/>

                                <TabControl Grid.Row="1"
                                            ItemsSource="{Binding ResultTables}"
                                            BorderThickness="0"
                                            Visibility="{Binding HasResultTables, Converter={StaticResource BoolToVis}}">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TableName}"/>
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate>
                                            <DataGrid ItemsSource="{Binding}"
                                                      AutoGenerateColumns="True"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      AlternatingRowBackground="#F8F8F8"
                                                      RowBackground="White"
                                                      BorderThickness="0"
                                                      SelectionMode="Single"
                                                      EnableRowVirtualization="True"
                                                      FontFamily="Segoe UI"
                                                      FontSize="12"/>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="History">
                            <Grid>
                                <TextBlock Text="INSERT, UPDATE, DELETE and other data-changing scripts will appear here."
                                           Foreground="#888"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>

                                <ListBox ItemsSource="{Binding HistoryEntries}"
                                         BorderThickness="0"
                                         Background="White"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E6E6E6"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,8">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="Rollback"
                                                                Margin="8,0,0,0"
                                                                Padding="8,2"
                                                                FontSize="11"
                                                                Cursor="Hand"
                                                                ToolTip="Open a new query with a rollback script"
                                                                Command="{Binding DataContext.OpenRollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding DatabaseDisplay}"
                                                                   Foreground="#666"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DatabaseDisplay, Converter={StaticResource NullToVisibility}}"/>
                                                        <TextBlock Text="{Binding ExecutedAtDisplay}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#333"
                                                                   VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding Script, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontFamily="Consolas"
                                                             FontSize="12"
                                                             MaxHeight="140"
                                                             VerticalScrollBarVisibility="Auto"
                                                             IsHitTestVisible="True"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
